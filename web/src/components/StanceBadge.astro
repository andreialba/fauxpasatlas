---
import {STANCE_LABEL, type Verdict} from '../lib/atlas'

interface Props {
  stance: Verdict
  /** Overrides the stance's own word, for "Split" on a contested claim. */
  label?: string
  size?: 'sm' | 'lg'
  solid?: boolean
  class?: string
}

const {stance, label, size = 'sm', solid = false, class: className = '', ...rest} = Astro.props
---

<span
  class:list={['badge', size === 'lg' && 'lg', solid && 'solid', className]}
  data-stance={stance}
  {...rest}
>
  {label ?? STANCE_LABEL[stance]}
</span>
